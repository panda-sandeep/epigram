# Dummy values committed on purpose so `next build` works without real
# credentials (module-level clients in src/modules require them).
# Provide real values in .env.local, which overrides this file.
MEDIASTACK_API_KEY=dummy-mediastack-key
EXA_API_KEY=dummy-exa-key
UPSTASH_REDIS_REST_URL=https://dummy-upstash-rest-url.example.com
UPSTASH_REDIS_REST_TOKEN=dummy-upstash-token
EPIGRAM_CRON_SECRET=dummy-cron-secret
BASE_URL=http://localhost:3000
EPIGRAM_SECRET_HEADER_NAME=X-Epigram-Secret
PER_TOPIC_NEWS_LIMIT=5
NEXT_PUBLIC_GA_ID=dummy-ga-id
